#!/usr/bin/env bash
set -euo pipefail

roots=(cmd internal e2e scripts)
if [[ -d experiments ]]; then
  roots+=(experiments)
fi

files=()
while IFS= read -r file; do
  files+=("$file")
done < <(find "${roots[@]}" -name '*.go' -type f -print)

if ((${#files[@]} == 0)); then
  exit 0
fi

unformatted="$(gofmt -l "${files[@]}")"
if [[ -n "$unformatted" ]]; then
  echo 'Go files need formatting; run make format' >&2
  printf '%s\n' "$unformatted" >&2
  exit 1
fi
