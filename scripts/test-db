#!/usr/bin/env bash
set -euo pipefail

packages=("$@")
if ((${#packages[@]} == 0)); then
  packages=(./internal/postgres/...)
fi

if [[ -n "${CARRY_TEST_DATABASE_URL:-}" ]]; then
  server_url="$CARRY_TEST_DATABASE_URL"
  suffix="$(openssl rand -hex 6)"
  database="carry_test_$(date -u +%Y%m%d%H%M%S)_${suffix}_postgres"
  created=false
  cleanup_external_database() {
    if [[ "$created" != true ]]; then
      return 0
    fi
    if go run ./scripts/check_test_database.go --drop "$database" "$server_url"; then
      created=false
      return 0
    fi
    return 1
  }
  trap cleanup_external_database EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  export CARRY_TEST_DATABASE_URL="$(go run ./scripts/check_test_database.go --create "$database" "$server_url")"
  created=true
  go run ./scripts/check_test_database.go --wait 30s "$CARRY_TEST_DATABASE_URL"
  go test -count=1 -tags=integration "${packages[@]}"
  cleanup_external_database
  trap - EXIT INT TERM
  exit 0
fi

if ! command -v docker >/dev/null 2>&1; then
  echo 'Docker or CARRY_TEST_DATABASE_URL is required for PostgreSQL tests' >&2
  exit 1
fi

suffix="$(openssl rand -hex 6)"
container="carry-test-$(date -u +%Y%m%d%H%M%S)-$suffix"
database="carry_test_$(date -u +%Y%m%d%H%M%S)_${suffix}_postgres"
cleanup() {
  docker rm -f "$container" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

docker run --detach --rm \
  --name "$container" \
  --env POSTGRES_DB="$database" \
  --env POSTGRES_PASSWORD=carry_test \
  --publish 127.0.0.1::5432 \
  postgres:17-alpine >/dev/null

port="$(docker port "$container" 5432/tcp | awk -F: 'NR == 1 {print $NF}')"
export CARRY_TEST_DATABASE_URL="postgres://postgres:carry_test@127.0.0.1:${port}/${database}?sslmode=disable"
go run ./scripts/check_test_database.go --wait 30s "$CARRY_TEST_DATABASE_URL"
go test -count=1 -tags=integration "${packages[@]}"
